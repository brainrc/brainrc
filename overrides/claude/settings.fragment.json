{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"{{hooks_dir}}/guard_outward.py\"; [ ! -f \"$f\" ] || python3 \"$f\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"{{hooks_dir}}/guard_secrets.py\"; [ ! -f \"$f\" ] || python3 \"$f\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"{{hooks_dir}}/check_mcp_pins.py\"; [ ! -f \"$f\" ] || python3 \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
