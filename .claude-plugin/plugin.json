{
  "name": "brainrc",
  "version": "0.7.0",
  "description": "Skills, agents, commands, and guard hooks for spec-driven work: spec-agent takes a ticket to a reviewed PR through approval gates.",
  "author": {
    "name": "brainrc contributors"
  },
  "license": "MIT",
  "skills": "./packs/gatework/skills/",
  "agents": [
    "./packs/gatework/agents/analyst.md",
    "./packs/gatework/agents/architect.md",
    "./packs/gatework/agents/brainrc-analyst.md",
    "./packs/gatework/agents/brainrc-architect.md",
    "./packs/gatework/agents/brainrc-code-reviewer.md",
    "./packs/gatework/agents/brainrc-doc-writer.md",
    "./packs/gatework/agents/brainrc-implementer.md",
    "./packs/gatework/agents/brainrc-infra-reviewer.md",
    "./packs/gatework/agents/brainrc-researcher.md",
    "./packs/gatework/agents/brainrc-security-reviewer.md",
    "./packs/gatework/agents/brainrc-test-writer.md",
    "./packs/gatework/agents/brainrc-verifier.md",
    "./packs/gatework/agents/code-reviewer.md",
    "./packs/gatework/agents/doc-writer.md",
    "./packs/gatework/agents/implementer.md",
    "./packs/gatework/agents/infra-reviewer.md",
    "./packs/gatework/agents/researcher.md",
    "./packs/gatework/agents/security-reviewer.md",
    "./packs/gatework/agents/test-writer.md",
    "./packs/gatework/agents/verifier.md"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/overrides/claude/hooks/guard_outward.py\"; [ ! -f \"$f\" ] || python3 \"$f\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/overrides/claude/hooks/guard_secrets.py\"; [ ! -f \"$f\" ] || python3 \"$f\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
