{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{hooks_dir}}/guard_outward.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{hooks_dir}}/guard_secrets.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
