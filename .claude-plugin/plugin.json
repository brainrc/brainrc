{
  "name": "brainrc",
  "version": "0.7.3",
  "description": "Guard hooks for AI coding harnesses. Gatework, the spec-driven skills and agents, is its own plugin: brainrc/gatework.",
  "author": {
    "name": "brainrc contributors"
  },
  "license": "MIT",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/overrides/claude/hooks/guard_outward.py\"; [ ! -f \"$f\" ] || python3 \"$f\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/overrides/claude/hooks/guard_secrets.py\"; [ ! -f \"$f\" ] || python3 \"$f\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
