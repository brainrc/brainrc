{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"{{hooks_dir}}/guard.py\"; [ ! -f \"$f\" ] || ! command -v python3 >/dev/null || python3 \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
