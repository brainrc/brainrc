{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(exec|read|write|edit|apply_patch|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"{{hooks_dir}}/guard.py\"; [ ! -f \"$f\" ] || python3 \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
