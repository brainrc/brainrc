{
  "pack_api": "1.0",
  "contract": [
    "agent model haiku",
    "agent model inherit",
    "agent model opus",
    "agent model sonnet",
    "kind agents",
    "kind commands",
    "kind skills",
    "layout agents/<prefix>*.md: frontmatter name (= file stem), description; optional model, tools",
    "layout commands/<prefix>*.md: frontmatter description",
    "layout extensions.md: rendered from [extensions.*] and validator render_extensions",
    "layout mcp/servers.toml",
    "layout naming: skills, agents, commands and MCP servers start with the pack's prefix",
    "layout overrides/claude/hooks/: linked to <hooks_dir>-<name>",
    "layout overrides/claude/settings.fragment.json: merged after core's; {{hooks_dir}} placeholder",
    "layout overrides/opencode/plugin.js: linked as brainrc-guard-<name>.js",
    "layout pack.toml",
    "layout rules/NN-*.md: frontmatter trigger, alwaysApply: true; rendered after core's rules",
    "layout skills/<prefix>*/SKILL.md: frontmatter name (= folder), description",
    "layout tests: unittest tests that validate --pack runs (pack.toml `test`)",
    "layout tripwires.toml: [[tripwire]] pattern, message, allow, paths, exclude",
    "layout validator: a Python module in the pack (pack.toml `validator`)",
    "mcp/servers.toml .: type \"object\"",
    "mcp/servers.toml servers.*.args: type \"array\"",
    "mcp/servers.toml servers.*.args[]: type \"string\"",
    "mcp/servers.toml servers.*.command: minLength 1",
    "mcp/servers.toml servers.*.command: type \"string\"",
    "mcp/servers.toml servers.*.env_from: type \"array\"",
    "mcp/servers.toml servers.*.env_from[]: pattern \"^[A-Za-z_][A-Za-z0-9_]*$\"",
    "mcp/servers.toml servers.*.env_from[]: type \"string\"",
    "mcp/servers.toml servers.*.harnesses: type \"array\"",
    "mcp/servers.toml servers.*.harnesses[]: minLength 1",
    "mcp/servers.toml servers.*.harnesses[]: type \"string\"",
    "mcp/servers.toml servers.*.url: minLength 1",
    "mcp/servers.toml servers.*.url: type \"string\"",
    "mcp/servers.toml servers.*: type \"object\"",
    "mcp/servers.toml servers.<key>: pattern \"^[A-Za-z0-9_-]+$\"",
    "mcp/servers.toml servers: type \"object\"",
    "naming id ([a-z0-9]+(?:-[a-z0-9]+)*)/([a-z0-9]+(?:-[a-z0-9]+)*)",
    "naming item ^[a-z0-9]+(-[a-z0-9]+)*$",
    "naming name [a-z0-9]+(?:-[a-z0-9]+)*",
    "pack.toml .: type \"object\"",
    "pack.toml description: type \"string\"",
    "pack.toml extensions: type \"object\"",
    "pack.toml guard.ask: type \"array\"",
    "pack.toml guard.ask[].host: pattern \"^(\\\\*\\\\.)?[A-Za-z0-9-]+(\\\\.[A-Za-z0-9-]+)*$\"",
    "pack.toml guard.ask[].host: type \"string\"",
    "pack.toml guard.ask[].match: minLength 1",
    "pack.toml guard.ask[].match: type \"string\"",
    "pack.toml guard.ask[].path: pattern \"^(~/|/)\"",
    "pack.toml guard.ask[].path: type \"string\"",
    "pack.toml guard.ask[].reason: minLength 1",
    "pack.toml guard.ask[].reason: type \"string\"",
    "pack.toml guard.ask[].scope.aws_profiles: type \"array\"",
    "pack.toml guard.ask[].scope.aws_profiles[]: minLength 1",
    "pack.toml guard.ask[].scope.aws_profiles[]: type \"string\"",
    "pack.toml guard.ask[].scope.kube_contexts: type \"array\"",
    "pack.toml guard.ask[].scope.kube_contexts[]: minLength 1",
    "pack.toml guard.ask[].scope.kube_contexts[]: type \"string\"",
    "pack.toml guard.ask[].scope.paths: type \"array\"",
    "pack.toml guard.ask[].scope.paths[]: minLength 1",
    "pack.toml guard.ask[].scope.paths[]: type \"string\"",
    "pack.toml guard.ask[].scope.remotes: type \"array\"",
    "pack.toml guard.ask[].scope.remotes[]: minLength 1",
    "pack.toml guard.ask[].scope.remotes[]: type \"string\"",
    "pack.toml guard.ask[].scope.tickets: type \"array\"",
    "pack.toml guard.ask[].scope.tickets[]: minLength 1",
    "pack.toml guard.ask[].scope.tickets[]: type \"string\"",
    "pack.toml guard.ask[].scope: type \"object\"",
    "pack.toml guard.ask[].tool: pattern \"^mcp__\"",
    "pack.toml guard.ask[].tool: type \"string\"",
    "pack.toml guard.ask[]: requires reason",
    "pack.toml guard.ask[]: type \"object\"",
    "pack.toml guard.deny: type \"array\"",
    "pack.toml guard.deny[].host: pattern \"^(\\\\*\\\\.)?[A-Za-z0-9-]+(\\\\.[A-Za-z0-9-]+)*$\"",
    "pack.toml guard.deny[].host: type \"string\"",
    "pack.toml guard.deny[].match: minLength 1",
    "pack.toml guard.deny[].match: type \"string\"",
    "pack.toml guard.deny[].path: pattern \"^(~/|/)\"",
    "pack.toml guard.deny[].path: type \"string\"",
    "pack.toml guard.deny[].reason: minLength 1",
    "pack.toml guard.deny[].reason: type \"string\"",
    "pack.toml guard.deny[].scope.aws_profiles: type \"array\"",
    "pack.toml guard.deny[].scope.aws_profiles[]: minLength 1",
    "pack.toml guard.deny[].scope.aws_profiles[]: type \"string\"",
    "pack.toml guard.deny[].scope.kube_contexts: type \"array\"",
    "pack.toml guard.deny[].scope.kube_contexts[]: minLength 1",
    "pack.toml guard.deny[].scope.kube_contexts[]: type \"string\"",
    "pack.toml guard.deny[].scope.paths: type \"array\"",
    "pack.toml guard.deny[].scope.paths[]: minLength 1",
    "pack.toml guard.deny[].scope.paths[]: type \"string\"",
    "pack.toml guard.deny[].scope.remotes: type \"array\"",
    "pack.toml guard.deny[].scope.remotes[]: minLength 1",
    "pack.toml guard.deny[].scope.remotes[]: type \"string\"",
    "pack.toml guard.deny[].scope.tickets: type \"array\"",
    "pack.toml guard.deny[].scope.tickets[]: minLength 1",
    "pack.toml guard.deny[].scope.tickets[]: type \"string\"",
    "pack.toml guard.deny[].scope: type \"object\"",
    "pack.toml guard.deny[].tool: pattern \"^mcp__\"",
    "pack.toml guard.deny[].tool: type \"string\"",
    "pack.toml guard.deny[]: requires reason",
    "pack.toml guard.deny[]: type \"object\"",
    "pack.toml guard: type \"object\"",
    "pack.toml id: type \"string\"",
    "pack.toml max_always_tokens: minimum 0",
    "pack.toml max_always_tokens: type \"number\"",
    "pack.toml name: minLength 1",
    "pack.toml name: type \"string\"",
    "pack.toml prefix: minLength 1",
    "pack.toml prefix: type \"string\"",
    "pack.toml requires_api: minLength 1",
    "pack.toml requires_api: type \"string\"",
    "pack.toml requires_core: type \"string\"",
    "pack.toml scope.aws_profiles: type \"array\"",
    "pack.toml scope.aws_profiles[]: minLength 1",
    "pack.toml scope.aws_profiles[]: type \"string\"",
    "pack.toml scope.kube_contexts: type \"array\"",
    "pack.toml scope.kube_contexts[]: minLength 1",
    "pack.toml scope.kube_contexts[]: type \"string\"",
    "pack.toml scope.paths: type \"array\"",
    "pack.toml scope.paths[]: minLength 1",
    "pack.toml scope.paths[]: type \"string\"",
    "pack.toml scope.remotes: type \"array\"",
    "pack.toml scope.remotes[]: minLength 1",
    "pack.toml scope.remotes[]: type \"string\"",
    "pack.toml scope.tickets: type \"array\"",
    "pack.toml scope.tickets[]: minLength 1",
    "pack.toml scope.tickets[]: type \"string\"",
    "pack.toml scope: type \"object\"",
    "pack.toml test: minLength 1",
    "pack.toml test: type \"string\"",
    "pack.toml validator: minLength 1",
    "pack.toml validator: type \"string\"",
    "validator LEGACY_KEYS",
    "validator LEGACY_NAMESPACES",
    "validator NAMESPACE",
    "validator check",
    "validator check_extensions",
    "validator doctor",
    "validator render_extensions",
    "validator warn_extensions"
  ]
}
